# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Parser Configuration
PARSER_INTERVAL_MINUTES=15
MAX_LISTINGS_PER_RUN=50

# Database Configuration
DATABASE_URL=sqlite:///data/classifieds_parser.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/parser.log

# Avito Configuration
AVITO_URL=https://www.avito.ru/ivanovo/telefony

# Youla Configuration
YOULA_ENABLED=true

# Drom Configuration
DROM_ENABLED=true

# Farpost Configuration
FARPOST_URL=https://www.farpost.ru/vladivostok/auto/
FARPOST_ENABLED=true

# Proxy Configuration (optional)
USE_PROXY=false
PROXY_URL=
